# ─────────────────────────────────────────────────────────────
# Vespera AI — Phase 1 environment template
# Copy to `.env` (root, for docker-compose) and fill per-app files:
#   apps/web/.env.local   apps/api/.env
# ─────────────────────────────────────────────────────────────

# ---- Supabase (DB + Auth) ----
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
# Direct Postgres connection (server-side, e.g. SQLAlchemy async)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

# ---- Qdrant (vector DB) ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=vespera_knowledge

# ---- Gemini (single-worker triage agent, Phase 1) ----
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004

# ---- API server ----
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
CORS_ALLOW_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# ---- Web client ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
